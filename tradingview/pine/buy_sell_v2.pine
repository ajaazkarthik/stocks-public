                else
                    log.info("Bullish 4 simple breakout skipped " + syminfo.ticker +' sqzOff: '+ str.tostring(sqzOff)+ " " + timeframe.period + "\n" + "Volume: " + str.tostring(nz(b.v)) + "\n" + "vSMA: " + str.tostring(vSMA) + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "MACD: " + str.tostring(macdVal) + "\n" + "Signal: " + str.tostring(signalVal) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))


        // else if lSt.b and b.o[1] < lRt.bx.get_top() and b.h[1] > lRt.bx.get_bottom() and b.c[1] < lRt.bx.get_bottom() and not lRt.r and b.i[1] != lRt.bx.get_left()
        //     label.new(b.i[1], b.h[1] * (1 + lRt.m * .017), 'R', color = srRDC, style = label.style_label_down , textcolor = srRTC, size = f_getSize(srRS), tooltip = 'Re-test of Resistance Zone' + vST[1] )
        //     lRt.r := true //
        //     lRt.bx.set_right(b.i)
        //     lRt.ln.set_x2(b.i)

        //     if srRS != 'None'
        //         na
                //alert('Re-test of resistance zone detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)

        // else if b.h[1] > lRt.bx.get_bottom() and b.c[1] < lRt.bx.get_top() and b.c < lRt.bx.get_top() and not lRt.t and not lRt.b and not lSt.b and b.i[1] != lRt.bx.get_left()
        //     label.new(b.i[1], b.h[1] * (1 + lRt.m * .017), 'T', color = srTDC, style = label.style_label_down , textcolor = srTTC, size = f_getSize(srTS), tooltip = 'Test of Resistance Zone' + vST[1] )
        //     lRt.t := true
        //     lRt.bx.set_right(b.i)
        //     lRt.ln.set_x2(b.i)

        //     if srTS != 'None'
        //         na
             //   alert('Test of resistance zone detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period, alert.freq_once_per_bar_close)

        else if b.h > lRt.bx.get_bottom() * (1 - lRt.m * .17) and not lRt.b
            if b.h > lRt.bx.get_bottom()
                lRt.bx.set_right(b.i)
            lRt.ln.set_x2(b.i)

        if mnSH
            if b.h > lRt.bx.get_top() and b.c <= lRt.bx.get_top() * (1 + lRt.m * .17 * mnMR) and not lRt.l and b.i == lRt.bx.get_right()
                if lRt.lq.get_right() + srLN > b.i
                    lRt.lq.set_right(b.i + 1)
                    lRt.lq.set_top(math.min(math.max(b.h, lRt.lq.get_top()), lRt.bx.get_top() * (1 + lRt.m * .17 * mnMR)))
                else
                    lRt.lq.set_lefttop(b.i[1], math.min(b.h, lRt.bx.get_top() * (1 + lRt.m * .17 * mnMR)))
                    lRt.lq.set_rightbottom(b.i + 1, lRt.bx.get_top())
                    lRt.lq.set_bgcolor(mnRZC)
    
                lRt.l := true
    
            else if b.h > lRt.bx.get_top() and b.c <= lRt.bx.get_top() * (1 + lRt.m * .17 * mnMR) and lRt.l and b.i == lRt.bx.get_right()
                lRt.lq.set_right(b.i + 1)
                lRt.lq.set_top(math.min(math.max(b.h, lRt.lq.get_top()), lRt.bx.get_top() * (1 + lRt.m * .17 * mnMR)))
            else if lRt.l and (b.c >= lRt.bx.get_top() * (1 + lRt.m * .17 * mnMR) or b.c < lRt.bx.get_bottom())
                lRt.l := false

if S.size() > 1
    lS := S.get(0)

    if  srFBO and b.c[1] < lS.bx.get_bottom() * (1 - lS.m * .17) and not lS.b
        lS.bx.set_right(b.i[1])
        lS.ln.set_x2(b.i[1])
        lS.b := true
        lS.r := false

        label.new(b.i[1], b.h[1] * (1 + lS.m * .017), 'B\n\n▼', color = srBDC, style = label.style_label_down , textcolor = srBTC, size = f_getSize(srBS), tooltip = 'Bearish Breakout' + vST[1] )
        //label.new(b.i[1], b.h[1] * (1 + lS.m * .017), 'B\n\n▼', color = color.yellow, style = label.style_label_down , textcolor = srBTC, size = f_getSize(srBS), tooltip = 'Bearish Breakout' + vST[1] )

        R.unshift(
          SnR.new(
             box.new(b.i[1], lS.bx.get_top(), b.i + 1, lS.bx.get_bottom(), border_color = color(na), bgcolor = srRZC),
             box.new(na, na, na, na, bgcolor = color(na), border_color = color(na)),
             line.new(b.i[1], lS.bx.get_top(), b.i + 1, lS.bx.get_top(), color = srRLC, width = srMR <= .5 ? 2 : 3),
             false, false, false, false, lS.m))
        //S.remove(0)

        if (srBS != 'None')
            log.info('1 Bearish breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
            if (nz(b.v) > vSMA * 1 and rsi <= 30 and macdBelowSignal)
                na
                //alert('Bearish 1 breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
            else
                log.info("Debug Info — Bearish breakout detected " + syminfo.ticker + " " + timeframe.period + "\n" + "Volume: " + str.tostring(nz(b.v)) + "\n" + "vSMA: " + str.tostring(vSMA) + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "MACD: " + str.tostring(macdVal) + "\n" + "Signal: " + str.tostring(signalVal) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))

    if  b.c[1] < lS.bx.get_bottom() and not lS.b and not srFBO
        lS.bx.set_right(b.i[1])
        lS.ln.set_x2(b.i[1])
        lS.b := true
        lS.r := false

        label.new(b.i[1], b.h[1] * (1 + lS.m * .017), 'B\n\n▼', color = srBDC, style = label.style_label_down , textcolor = srBTC, size = f_getSize(srBS), tooltip = 'Bearish Breakout' + vST[1] )

        R.unshift(
          SnR.new(
             box.new(b.i[1], lS.bx.get_top(), b.i + 1, lS.bx.get_bottom(), border_color = color(na), bgcolor = srRZC),
             box.new(na, na, na, na, bgcolor = color(na), border_color = color(na)),
             line.new(b.i[1], lS.bx.get_top(), b.i + 1, lS.bx.get_top(), color = srRLC, width = srMR <= .5 ? 2 : 3),
             false, false, false, false, lS.m))
        //S.remove(0)

        if (srBS != 'None')
            log.info('2 Bearish breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
            if (nz(b.v) > vSMA * 1 and rsi <= 30 and macdBelowSignal)
                na
                //alert('Bearish 2 breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
            else
                log.info("Debug Info — Bearish breakout detected " + syminfo.ticker + " " + timeframe.period + "\n" + "Volume: " + str.tostring(nz(b.v)) + "\n" + "vSMA: " + str.tostring(vSMA) + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "MACD: " + str.tostring(macdVal) + "\n" + "Signal: " + str.tostring(signalVal) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))

    // else if lR.b and b.o[1] > lS.bx.get_bottom() and b.l[1] < lS.bx.get_top() and b.c[1] > lS.bx.get_top() and not lS.r and b.i[1] != lS.bx.get_left()
    //     label.new(b.i[1], b.l[1] * (1 - lS.m * .017), 'R', color = srRUC, style = label.style_label_up , textcolor = srRTC, size = f_getSize(srRS), tooltip = 'Re-test of Support Zone' + vST[1] )
    //     lS.r := true //
    //     lS.bx.set_right(b.i)
    //     lS.ln.set_x2(b.i)

    //     if srRS != 'None'
    //         na
    //         //alert('Re-test of support zone detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)

    // else if b.l[1] < lS.bx.get_top() and b.c[1] > lS.bx.get_bottom() and b.c > lS.bx.get_bottom() and not lS.t and not lS.b and not lR.b and b.i[1] != lS.bx.get_left()
    //     label.new(b.i[1], b.l[1] * (1 - lS.m * .017), 'T', color = srTUC, style = label.style_label_up , textcolor = srTTC, size = f_getSize(srTS), tooltip = 'Test of Support Zone' + vST[1] )
    //     lS.t := true
    //     lS.bx.set_right(b.i)
    //     lS.ln.set_x2(b.i)

    //     if srTS != 'None'
    //         na
            //alert('Test of support zone detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period, alert.freq_once_per_bar_close)

    else if b.l < lS.bx.get_top() * (1 + lS.m * .17) and not lS.b //and lS.bx.get_bottom() != lR.bx.get_bottom()
        if b.l < lS.bx.get_top()
            lS.bx.set_right(b.i)
        lS.ln.set_x2(b.i)

    // if isLUS[1] and isHV[1] and srPS != 'None'
    //     label.new(b.i[1], b.h[1] * (1 + lS.m * .017), '', color = srPDC, style = label.style_label_down , textcolor = color.white, size = f_getSize(srPS), tooltip = 'Rejection of Higher Prices' + vST[1] )
    //     //alert('Rejection of higher prices detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)

    if mnSH
        if b.l < lS.bx.get_bottom() and b.c >= lS.bx.get_bottom() * (1 - lS.m * .17 * mnMR) and not lS.l and b.i == lS.bx.get_right()
            if lS.lq.get_right() + srLN > b.i
                lS.lq.set_right(b.i + 1)
                lS.lq.set_bottom(math.max(math.min(b.l, lS.lq.get_bottom()), lS.bx.get_bottom() * (1 - lS.m * .17 * mnMR)))
            else
                lS.lq.set_lefttop(b.i[1], lS.bx.get_bottom())
                lS.lq.set_rightbottom(b.i + 1, math.max(b.l, lS.bx.get_bottom() * (1 - lS.m * .17 * mnMR)))
                lS.lq.set_bgcolor(mnSZC)

            lS.l := true

        else if b.l < lS.bx.get_bottom() and b.c >= lS.bx.get_bottom() * (1 - lS.m * .17 * mnMR) and lS.l and b.i == lS.bx.get_right()
            lS.lq.set_right(b.i + 1)
            lS.lq.set_bottom(math.max(math.min(b.l, lS.lq.get_bottom()), lS.bx.get_bottom() * (1 - lS.m * .17 * mnMR)))
        else if lS.l and (b.c <= lS.bx.get_bottom() * (1 - lS.m * .17 * mnMR) or b.c > lS.bx.get_top())
            lS.l := false

if S.size() > 2 and srHST //and (lR.b or lS.b)// and lS.bx.get_bottom() != lR.bx.get_bottom() 
    lSt := S.get(1)

    if lS.bx.get_bottom() != lSt.bx.get_bottom()

        if  srFBO and b.c[1] < lSt.bx.get_bottom() * (1 - lSt.m * .17) and not lSt.b //and b.i[1] != lR.bx.get_left()
            lSt.bx.set_right(b.i[1])
            lSt.ln.set_x2(b.i[1])
            lSt.b := true
            lSt.r := false

            label.new(b.i[1], b.h[1] * (1 + lSt.m * .017), 'B\n\n▼', color = srBDC, style = label.style_label_down , textcolor = srBTC, size = f_getSize(srBS), tooltip = 'Bearish Breakout' + vST[1] )

            R.unshift(
              SnR.new(
                 box.new(b.i[1], lSt.bx.get_top(), b.i + 1, lSt.bx.get_bottom(), border_color = color(na), bgcolor = srRZC),
                 box.new(na, na, na, na, bgcolor = color(na), border_color = color(na)),
                 line.new(b.i[1], lSt.bx.get_top(), b.i + 1, lSt.bx.get_top(), color = srRLC, width = srMR <= .5 ? 2 : 3),
                 false, false, false, false, lSt.m))
            //S.remove(1)

            if (srBS != 'None')
                log.info('3 Bearish breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
                if (nz(b.v) > vSMA * 1 and rsi <= 30 and macdBelowSignal)
                    na
                    //alert('Bearish 3 breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
                else
                    log.info("Debug Info — Bearish breakout detected " + syminfo.ticker + " " + timeframe.period + "\n" + "Volume: " + str.tostring(nz(b.v)) + "\n" + "vSMA: " + str.tostring(vSMA) + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "MACD: " + str.tostring(macdVal) + "\n" + "Signal: " + str.tostring(signalVal) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))

        else if b.c[1] < lSt.bx.get_bottom() and not lSt.b and not srFBO //and b.i[1] != lR.bx.get_left()
            lSt.bx.set_right(b.i[1])
            lSt.ln.set_x2(b.i[1])
            lSt.b := true
            lSt.r := false

            label.new(b.i[1], b.h[1] * (1 + lSt.m * .017), 'B\n\n▼', color = srBDC, style = label.style_label_down , textcolor = srBTC, size = f_getSize(srBS), tooltip = 'Bearish Breakout' + vST[1] )

            R.unshift(
              SnR.new(
                 box.new(b.i[1], lSt.bx.get_top(), b.i + 1, lSt.bx.get_bottom(), border_color = color(na), bgcolor = srRZC),
                 box.new(na, na, na, na, bgcolor = color(na), border_color = color(na)),
                 line.new(b.i[1], lSt.bx.get_top(), b.i + 1, lSt.bx.get_top(), color = srRLC, width = srMR <= .5 ? 2 : 3),
                 false, false, false, false, lSt.m))
            //S.remove(1)

            if (srBS != 'None')
                log.info('4 Bearish breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
                if (nz(b.v) > vSMA * 1 and rsi <= 30 and macdBelowSignal)
                    na
                    //alert('Bearish 4 breakout detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)
                else
                    log.info("Debug Info — Bearish breakout detected " + syminfo.ticker + " " + timeframe.period + "\n" + "Volume: " + str.tostring(nz(b.v)) + "\n" + "vSMA: " + str.tostring(vSMA) + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "MACD: " + str.tostring(macdVal) + "\n" + "Signal: " + str.tostring(signalVal) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))

        // else if lRt.b and b.o[1] > lSt.bx.get_bottom() and b.l[1] < lSt.bx.get_top() and b.c[1] > lSt.bx.get_top() and not lSt.r and b.i[1] != lSt.bx.get_left() //and lSt.bx.get_top() != lS.bx.get_top() //DGT
        //     label.new(b.i[1], b.l[1] * (1 - lSt.m * .017), 'R', color = srRUC, style = label.style_label_up , textcolor = srRTC, size = f_getSize(srRS), tooltip = 'Re-test of Support Zone' + vST[1] )
        //     lSt.r := true
        //     lSt.bx.set_right(b.i)
        //     lSt.ln.set_x2(b.i)

        //     if srRS != 'None'
        //         na
                //alert('Re-test of support zone detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period)

        // else if b.l[1] < lSt.bx.get_top() and b.c[1] > lSt.bx.get_bottom() and b.c > lSt.bx.get_bottom() and not lSt.t and not lSt.b and not lRt.b and b.i[1] != lSt.bx.get_left()
        //     label.new(b.i[1], b.l[1] * (1 - lSt.m * .017), 'T', color = srTUC, style = label.style_label_up , textcolor = srTTC, size = f_getSize(srTS), tooltip = 'Test of Support Zone' + vST[1] )
        //     lSt.t := true
        //     lSt.bx.set_right(b.i)
        //     lSt.ln.set_x2(b.i)

        //     if srTS != 'None'
        //         na
                //alert('Test of support zone detected\n' + syminfo.ticker + ' price (' + str.tostring(b.c, format.mintick) + '), timeframe ' + timeframe.period, alert.freq_once_per_bar_close)

        else if b.l < lSt.bx.get_top() * (1 + lSt.m * .17) and not lSt.b
            if b.l < lSt.bx.get_top()
                lSt.bx.set_right(b.i)
            lSt.ln.set_x2(b.i)

        if mnSH
            if b.l < lSt.bx.get_bottom() and b.c >= lSt.bx.get_bottom() * (1 - lSt.m * .17 * mnMR) and not lSt.l and b.i == lSt.bx.get_right()
                if lSt.lq.get_right() + srLN > b.i
                    lSt.lq.set_right(b.i + 1)
                    lSt.lq.set_bottom(math.max(math.min(b.l, lSt.lq.get_bottom()), lSt.bx.get_bottom() * (1 - lSt.m * .17 * mnMR)))
                else
                    lSt.lq.set_lefttop(b.i[1], lSt.bx.get_bottom())
                    lSt.lq.set_rightbottom(b.i + 1, math.max(b.l, lSt.bx.get_bottom() * (1 - lSt.m * .17 * mnMR)))
                    lSt.lq.set_bgcolor(mnSZC)

                lSt.l := true

            else if b.l < lSt.bx.get_bottom() and b.c >= lSt.bx.get_bottom() * (1 - lSt.m * .17 * mnMR) and lSt.l and b.i == lSt.bx.get_right()
                lSt.lq.set_right(b.i + 1)
                lSt.lq.set_bottom(math.max(math.min(b.l, lSt.lq.get_bottom()), lSt.bx.get_bottom() * (1 - lSt.m * .17 * mnMR)))
            else if lSt.l and (b.c <= lSt.bx.get_bottom() * (1 - lS.m * .17 * mnMR) or b.c > lSt.bx.get_top())
                lSt.l := false

//-----------------------------------------------------------------------------}

// Inputs
src = close
useCurrentRes = input(true, title="Use Current Chart Resolution?")
resCustom = input.timeframe(title="Use Different Timeframe? Uncheck Box Above", defval="D")
len = input.int(20, title="Moving Average Length - LookBack Period")
factorT3 = input.int(defval=7, title="Tilson T3 Factor - *.10 - so 7 = .7 etc.", minval=0)
atype = input.int(1, minval=1, maxval=8, title="1=SMA, 2=EMA, 3=WMA, 4=HullMA, 5=VWMA, 6=RMA, 7=TEMA, 8=Tilson T3")
spc = input(false, title="Show Price Crossing 1st Mov Avg - Highlight Bar?")
cc = input(true, title="Change Color Based On Direction?")
smoothe = input.int(2, minval=1, maxval=10, title="Color Smoothing - Setting 1 = No Smoothing")
doma2 = input(false, title="Optional 2nd Moving Average")
spc2 = input(false, title="Show Price Crossing 2nd Mov Avg?")
len2 = input.int(50, title="Moving Average Length - Optional 2nd MA")
sfactorT3 = input.int(defval=7, title="Tilson T3 Factor - *.10 - so 7 = .7 etc.", minval=0)
atype2 = input.int(1, minval=1, maxval=8, title="1=SMA, 2=EMA, 3=WMA, 4=HullMA, 5=VWMA, 6=RMA, 7=TEMA, 8=Tilson T3")
cc2 = input(true, title="Change Color Based On Direction 2nd MA?")
warn = input(false, title="***You Can Turn On The Show Dots Parameter Below Without Plotting 2nd MA to See Crosses***")
warn2 = input(false, title="***If Using Cross Feature W/O Plotting 2ndMA - Make Sure 2ndMA Parameters are Set Correctly***")
sd = input(false, title="Show Dots on Cross of Both MA's")

res = useCurrentRes ? timeframe.period : resCustom

// Functions
gd(src, len, factor) =>
    ta.ema(src, len) * (1 + factor) - ta.ema(ta.ema(src, len), len) * factor

t3(src, len, factor) =>
    gd(gd(gd(src, len, factor), len, factor), len, factor)

hullma(src, len) =>
    ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))

tema(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema3 = ta.ema(ema2, len)
    3 * (ema1 - ema2) + ema3

// Main MA
factor = factorT3 * 0.10
avg = switch atype
    1 => ta.sma(src, len)
    2 => ta.ema(src, len)
    3 => ta.wma(src, len)
    4 => hullma(src, len)
    5 => ta.vwma(src, len)
    6 => ta.rma(src, len)
    7 => tema(src, len)
    8 => t3(src, len, factor)

// Second MA
sfactor = sfactorT3 * 0.10
avg2 = switch atype2
    1 => ta.sma(src, len2)
    2 => ta.ema(src, len2)
    3 => ta.wma(src, len2)
    4 => hullma(src, len2)
    5 => ta.vwma(src, len2)
    6 => ta.rma(src, len2)
    7 => tema(src, len2)
    8 => t3(src, len2, sfactor)

out1 = request.security(syminfo.tickerid, res, avg)
out2 = request.security(syminfo.tickerid, res, avg2)

// Crossing Logic
cr_up = open < out1 and close > out1
cr_Down = open > out1 and close < out1
cr_up2 = open < out2 and close > out2
cr_Down2 = open > out2 and close < out2

iscrossUp() => cr_up
iscrossDown() => cr_Down
iscrossUp2() => cr_up2
iscrossDown2() => cr_Down2

ma_up = out1 >= out1[smoothe]
ma_down = out1 < out1[smoothe]

if ma_down
    log.info("ma_down" + str.tostring(out1) + " smooth " + str.tostring(out1[smoothe]) )

// Colors
col = cc ? (ma_up ? color.lime : ma_down ? color.red : color.aqua) : color.aqua
//col2 = cc2 ? (ma_up ? color.lime : ma_down ? color.red : color.aqua) : color.white

// Plotting
plot(out1, title="Multi-Timeframe Moving Avg", color=col, linewidth=4)
//0plot(doma2 ? out2 : na, title="2nd Multi-TimeFrame Moving Average", color=col2, style=plot.style_circles, linewidth=4)
//plot(sd and ta.cross(out1, out2) ? out2 : na, style=plot.style_cross, linewidth=15, color=color.aqua)
cond = ma_up and sqzOff
if cond and not cond[1]
    //alert('MA breakout detected\n' + syminfo.ticker + ' timeframe ' + timeframe.period)
    log.info("MA breakout detected\n " + syminfo.ticker + " " + timeframe.period + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "ma_up: " + str.tostring(ma_up) + "\n" + "sqzOff: " + str.tostring(sqzOff) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))

//cond_down = ma_down //and sqzOn
cond_down =ma_down and out1 > close and out1 > open and open> close and nz(b.v) > vSMA * 1 
if cond_down and not cond_down[1]
    //alert('MA breakout detected\n' + syminfo.ticker + ' timeframe ' + timeframe.period)
    log.info("MA breakout detected\n " + syminfo.ticker + " " + timeframe.period + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "ma_up: " + str.tostring(ma_up) + "\n" + "sqzOff: " + str.tostring(sqzOff) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))

[plusDI, minusDI, adx] = ta.dmi(14, 14)

isStrategyPositive = strategy.netprofit > 0

// Get strategy performance metrics
closedTrades = strategy.closedtrades
winningTrades = strategy.wintrades

// Calculate win rate (handle zero-division case)
winRate = closedTrades > 0 ? (winningTrades / closedTrades) * 100 : 0

// Define condition: win rate must be at least 50%
isStrategyWinning = winRate >= 50

if srBuySignal
    log.info("macdAboveSignal: " + str.tostring(macdAboveSignal) + 
              ", rsi: " + str.tostring(rsi) + 
              ", ma_up: " + str.tostring(ma_up) + 
              ", BUY: " + str.tostring(BUY) + 
              ", LongTrade: " + str.tostring(LongTrade) + 
              ", srBuySignal: " + str.tostring(srBuySignal) + 
              ", percent_valid: " + str.tostring(percent_valid) + 
              ", adx: " + str.tostring(adx, "#.##") + 
              ", +DI: " + str.tostring(plusDI, "#.##") + 
              ", -DI: " + str.tostring(minusDI, "#.##") + 
              ", isStrategyPositive: " + str.tostring(isStrategyPositive))

// My strict alert condition and sqzOff
triggerBuy = macdAboveSignal and rsi >= 60  and ma_up  and (BUY or LongTrade or srBuySignal) and percent_valid and (adx > 10) and (plusDI > minusDI) and plusDI > 30//and isStrategyPositive

var bool canTriggerBuy = true
var bool canTriggerSell = false


// =============================================================================
// SELL SETTINGS  ➞ Enhanced multi-condition exit (gated by canTriggerSell)
// NOTE: triggerBuy is already computed above in the base code (kept as-is).
//       cond_down  is already computed above in the base code (kept as-is).
// =============================================================================
string SELL_GRP = "➞ Enhanced Sell Settings 🔻"

// ── Core stop multipliers ──
float atrStopMult  = input.float(2.0,  "ATR Hard Stop (× ATR)",          minval=0.5, maxval=5.0, step=0.1, group=SELL_GRP,
     tooltip="Sell immediately if price falls this many ATRs below entry price.")
float atrTrailMult = input.float(1.5,  "ATR Trailing Stop (× ATR)",      minval=0.5, maxval=5.0, step=0.1, group=SELL_GRP,
     tooltip="Base trailing stop: sell if close falls this many ATRs below HWM. Widens automatically when in big profit.")
float atrTrailWide = input.float(2.5,  "ATR Trail Wide (× ATR) — profit", minval=0.5, maxval=6.0, step=0.1, group=SELL_GRP,
     tooltip="Widen trailing stop to this multiplier once unrealised PnL exceeds the Profit Tier threshold (gives big winners more room).")
float profitTierPct= input.float(10.0, "Profit Tier % to widen trail",    minval=2.0, maxval=30.0, step=0.5, group=SELL_GRP,
     tooltip="Once price is this % above entry the ATR trailing stop switches from base ➜ wide multiplier.")
// ── RSI ──
int   rsiExitLevel = input.int(50,     "RSI Exit Level",                  minval=20,  maxval=65, group=SELL_GRP,
     tooltip="Sell when RSI drops below this level AND is declining for 2 bars. Raised from 45→50 based on backtest.")
int   rsiDecayBars = input.int(2,      "RSI Decay Bars (confirm)",        minval=1,   maxval=5,  group=SELL_GRP,
     tooltip="RSI must stay below exit level for this many bars before selling (reduces false exits in consolidation).")
// ── On/Off ──
bool  useMaBreak   = input.bool(true,  "MA Slope Sell",                   group=SELL_GRP,
     tooltip="MA(20) slope turns negative: close < MA[0] AND MA[0] < MA[3]. Less strict than old cond_down — fires more reliably.")
bool  useMacdCross = input.bool(true,  "MACD Bearish Cross Sell",         group=SELL_GRP,
     tooltip="MACD crosses below signal line (best-performing exit signal in backtest: 56% WR).")
bool  useMacdConfirm=input.bool(true,  "MACD Cross — require neg hist",   group=SELL_GRP,
     tooltip="Extra confirmation: only exit on MACD cross if the histogram is negative AND below previous bar.")
bool  useRsiDecay  = input.bool(true,  "RSI Decay Sell",                  group=SELL_GRP)
bool  useAtrStop   = input.bool(true,  "ATR Hard Stop Sell",              group=SELL_GRP)
bool  useAtrTrail  = input.bool(true,  "ATR Trailing Stop Sell",          group=SELL_GRP)
bool  useSuppBreak = input.bool(false, "Support Zone Break Sell",         group=SELL_GRP,
     tooltip="Sell when price breaks below current S-zone. Keep OFF in choppy markets.")

// =============================================================================
// Entry tracking  (updated when the BUY alert fires each cycle)
// =============================================================================
var float entryPriceRef = na    // close price when last BUY fired
var float hwmSinceEntry = na    // highest close since entry (trailing HWM)

// =============================================================================
// ATR for stop calculations
// =============================================================================
float atr14 = ta.atr(14)

// =============================================================================
// Sell sub-conditions  (all false when canTriggerSell = false, so no noise)
// =============================================================================

// ── Adaptive ATR trail multiplier ──
// Backtest finding: base 1.5× exits winners too early (5.97% avg left on table).
// Switch to wide multiplier once unrealised PnL exceeds profitTierPct.
float _unrealisedPct = (not na(entryPriceRef)) ? (close - entryPriceRef) / entryPriceRef * 100.0 : 0.0
float _effectiveTrailMult = (canTriggerSell and _unrealisedPct >= profitTierPct) ? atrTrailWide : atrTrailMult

// 1. ATR hard stop from entry price
sell_atr_stop  = useAtrStop and (not na(entryPriceRef)) and close < entryPriceRef - atrStopMult * atr14

// 2. Adaptive ATR trailing stop from high-water-mark
sell_atr_trail = useAtrTrail and (not na(hwmSinceEntry)) and close < hwmSinceEntry - _effectiveTrailMult * atr14

// 3. MA slope sell — simplified from strict cond_down edge: just require MA declining & price below MA
//    (backtest: old edge-triggered version fired only once in 5 years; this fires more reliably)
sell_ma_breakdown = useMaBreak and (ma < ma[3]) and close < ma

// 4. MACD bearish crossunder (best exit signal: 56% WR, least left on table)
//    Optional confirmation: histogram must also be negative AND declining
bool _macdCross = ta.crossunder(macdVal, signalVal)
bool _macdHistNegDecl = (macdVal - signalVal) < 0 and (macdVal - signalVal) < (macdVal[1] - signalVal[1])
sell_macd_cross = useMacdCross and _macdCross and (useMacdConfirm ? _macdHistNegDecl : true)

// 5. RSI decay — raised threshold 45→50, require rsiDecayBars consecutive bars below level
//    Using a counter tracked via var
var int _rsiDecayCount = 0
bool _rsiDecayRaw = rsi < rsiExitLevel and rsi < rsi[1]
_rsiDecayCount := _rsiDecayRaw ? _rsiDecayCount + 1 : 0
sell_rsi_decay = useRsiDecay and _rsiDecayCount >= rsiDecayBars

// 6. Support zone break (optional, OFF by default)
float _s_bot = S.size() > 0 ? S.get(0).bx.get_bottom() : na
float _s_mrg = S.size() > 0 ? S.get(0).m : 0.02
sell_supp_break = useSuppBreak and (not na(_s_bot)) and close < _s_bot * (1.0 - _s_mrg * 0.17) and close < close[1]

// Combined: any sub-condition triggers sell (order matters for label priority)
enhanced_sell = sell_atr_stop or sell_atr_trail or sell_ma_breakdown or sell_macd_cross or sell_rsi_decay or sell_supp_break

// Human-readable reason label (highest-priority first)
string sell_reason =
     sell_atr_stop    ? "🛑 ATR Hard Stop"                                              :
     sell_atr_trail   ? (_unrealisedPct >= profitTierPct ? "📉 Trail (Wide)" : "📉 ATR Trail Stop") :
     sell_ma_breakdown? "📊 MA Slope Break"                                             :
     sell_macd_cross  ? "⚡ MACD Cross"                                                 :
     sell_rsi_decay   ? "📛 RSI Decay"                                                  :
     sell_supp_break  ? "🔻 Support Break"                                              :
                        "SELL"

// =============================================================================
// State machine  (buy-first, then sell enabled — identical gate to original)
// =============================================================================
plot_buy  = false   // reset every bar
plot_sell = false   // reset every bar

// BUY — triggerBuy is computed above in base code, gate is canTriggerBuy
if triggerBuy and not triggerBuy[1] and canTriggerBuy
    plot_buy       := true
    canTriggerBuy  := false
    canTriggerSell := true      // unlock sell for next trigger
    entryPriceRef  := close     // record entry for ATR-stop
    hwmSinceEntry  := close     // reset trailing HWM
    srBuySignal    := false
    log.info("BUY fired: " + syminfo.ticker +
             " price=" + str.tostring(close, format.mintick) +
             " rsi="   + str.tostring(rsi, "#.0") +
             " macd="  + str.tostring(macdAboveSignal))

// Keep HWM updated while we're in a trade (canTriggerSell = true)
if canTriggerSell and not na(hwmSinceEntry)
    hwmSinceEntry := math.max(hwmSinceEntry, close)

// SELL — enhanced_sell, gated by canTriggerSell
if enhanced_sell and not enhanced_sell[1] and canTriggerSell
    plot_sell      := true
    canTriggerSell := false     // lock sell until next buy
    canTriggerBuy  := true      // allow next buy
    entryPriceRef  := na        // reset entry tracking
    hwmSinceEntry  := na
    log.info("SELL fired [" + sell_reason + "]: " + syminfo.ticker +
             " price=" + str.tostring(close, format.mintick) +
             " rsi="   + str.tostring(rsi, "#.0"))

// =============================================================================
// Visual shapes
// =============================================================================
plotshape(plot_buy,
     title    = "BUY Signal",
     location = location.belowbar,
     color    = color.rgb(0, 200, 100),
     style    = shape.labelup,
     size     = size.small,
     text     = "BUY",
     textcolor= color.white)

plotshape(plot_sell,
     title    = "SELL Signal",
     location = location.abovebar,
     color    = color.rgb(240, 40, 40),
     style    = shape.labeldown,
     size     = size.small,
     text     = "SELL",
     textcolor= color.white)

// Sell reason label (small, appears above bar)
if plot_sell
    label.new(bar_index, high * 1.003, sell_reason,
         style    = label.style_label_down,
         color    = color.new(color.red, 60),
         textcolor= color.white,
         size     = size.tiny)

// Draw ATR stop levels while in trade (visualise where stops sit)
plot(canTriggerSell and useAtrStop and not na(entryPriceRef) ?
         entryPriceRef - atrStopMult * atr14 : na,
     title="ATR Hard Stop", color=color.new(color.red, 30),
     linewidth=1, style=plot.style_linebr)

plot(canTriggerSell and useAtrTrail and not na(hwmSinceEntry) ?
         hwmSinceEntry - atrTrailMult * atr14 : na,
     title="ATR Trail Stop", color=color.new(color.orange, 30),
     linewidth=1, style=plot.style_linebr)

// =============================================================================
// Date filter & alerts
// =============================================================================
oneYearAgo  = timenow - 365 * 24 * 60 * 60 * 1000
isInLastYear= time >= oneYearAgo and time <= timenow

if plot_buy and isInLastYear
    alert("🚀 BUY: "  + syminfo.ticker +
          " | tf="    + timeframe.period +
          " | price=" + str.tostring(close, format.mintick) +
          " | rsi="   + str.tostring(rsi, "#.0") +
          " | sqzOff="+ str.tostring(sqzOff))

if plot_sell and isInLastYear
    alert("🔴 SELL [" + sell_reason + "]: " + syminfo.ticker +
          " | tf="     + timeframe.period +
          " | price="  + str.tostring(close, format.mintick) +
          " | rsi="    + str.tostring(rsi, "#.0") +
          " | entry="  + str.tostring(nz(entryPriceRef, close), format.mintick))

// alertcondition — set once in TradingView, fires per trigger
alertcondition(plot_buy,                       "BUY Signal",           "🚀 BUY {{ticker}} {{interval}} price={{close}}")
alertcondition(plot_sell,                      "SELL Signal",          "🔴 SELL {{ticker}} {{interval}} price={{close}}")
alertcondition(plot_sell and sell_atr_stop,    "SELL – ATR Hard Stop", "🛑 ATR Stop: {{ticker}} price={{close}}")
alertcondition(plot_sell and sell_atr_trail,   "SELL – ATR Trailing",  "📉 Trail Stop: {{ticker}} price={{close}}")
alertcondition(plot_sell and sell_ma_breakdown,"SELL – MA Breakdown",  "📊 MA Break: {{ticker}} price={{close}}")
alertcondition(plot_sell and sell_macd_cross,  "SELL – MACD Cross",    "⚡ MACD Cross: {{ticker}} price={{close}}")
alertcondition(plot_sell and sell_rsi_decay,   "SELL – RSI Decay",     "📛 RSI Decay: {{ticker}} price={{close}}")

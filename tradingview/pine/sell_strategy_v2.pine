// Inputs

src = close

useCurrentRes = input(true, title="Use Current Chart Resolution?")

resCustom = input.timeframe(title="Use Different Timeframe? Uncheck Box Above", defval="D")

len = input.int(20, title="Moving Average Length - LookBack Period")

factorT3 = input.int(defval=7, title="Tilson T3 Factor - *.10 - so 7 = .7 etc.", minval=0)

atype = input.int(1, minval=1, maxval=8, title="1=SMA, 2=EMA, 3=WMA, 4=HullMA, 5=VWMA, 6=RMA, 7=TEMA, 8=Tilson T3")

spc = input(false, title="Show Price Crossing 1st Mov Avg - Highlight Bar?")

cc = input(true, title="Change Color Based On Direction?")

smoothe = input.int(2, minval=1, maxval=10, title="Color Smoothing - Setting 1 = No Smoothing")

doma2 = input(false, title="Optional 2nd Moving Average")

spc2 = input(false, title="Show Price Crossing 2nd Mov Avg?")

len2 = input.int(50, title="Moving Average Length - Optional 2nd MA")

sfactorT3 = input.int(defval=7, title="Tilson T3 Factor - *.10 - so 7 = .7 etc.", minval=0)

atype2 = input.int(1, minval=1, maxval=8, title="1=SMA, 2=EMA, 3=WMA, 4=HullMA, 5=VWMA, 6=RMA, 7=TEMA, 8=Tilson T3")

cc2 = input(true, title="Change Color Based On Direction 2nd MA?")

warn = input(false, title="***You Can Turn On The Show Dots Parameter Below Without Plotting 2nd MA to See Crosses***")

warn2 = input(false, title="***If Using Cross Feature W/O Plotting 2ndMA - Make Sure 2ndMA Parameters are Set Correctly***")

sd = input(false, title="Show Dots on Cross of Both MA's")



res = useCurrentRes ? timeframe.period : resCustom



// Functions

gd(src, len, factor) =>

    ta.ema(src, len) * (1 + factor) - ta.ema(ta.ema(src, len), len) * factor



t3(src, len, factor) =>

    gd(gd(gd(src, len, factor), len, factor), len, factor)



hullma(src, len) =>

    ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))



tema(src, len) =>

    ema1 = ta.ema(src, len)

    ema2 = ta.ema(ema1, len)

    ema3 = ta.ema(ema2, len)

    3 * (ema1 - ema2) + ema3



// Main MA

factor = factorT3 * 0.10

avg = switch atype

    1 => ta.sma(src, len)

    2 => ta.ema(src, len)

    3 => ta.wma(src, len)

    4 => hullma(src, len)

    5 => ta.vwma(src, len)

    6 => ta.rma(src, len)

    7 => tema(src, len)

    8 => t3(src, len, factor)



// Second MA

sfactor = sfactorT3 * 0.10

avg2 = switch atype2

    1 => ta.sma(src, len2)

    2 => ta.ema(src, len2)

    3 => ta.wma(src, len2)

    4 => hullma(src, len2)

    5 => ta.vwma(src, len2)

    6 => ta.rma(src, len2)

    7 => tema(src, len2)

    8 => t3(src, len2, sfactor)



out1 = request.security(syminfo.tickerid, res, avg)

out2 = request.security(syminfo.tickerid, res, avg2)



// Crossing Logic

cr_up = open < out1 and close > out1

cr_Down = open > out1 and close < out1

cr_up2 = open < out2 and close > out2

cr_Down2 = open > out2 and close < out2



iscrossUp() => cr_up

iscrossDown() => cr_Down

iscrossUp2() => cr_up2

iscrossDown2() => cr_Down2



ma_up = out1 >= out1[smoothe]

ma_down = out1 < out1[smoothe]



if ma_down

    log.info("ma_down" + str.tostring(out1) + " smooth " + str.tostring(out1[smoothe]) )



// Colors

col = cc ? (ma_up ? color.lime : ma_down ? color.red : color.aqua) : color.aqua

//col2 = cc2 ? (ma_up ? color.lime : ma_down ? color.red : color.aqua) : color.white



// Plotting

plot(out1, title="Multi-Timeframe Moving Avg", color=col, linewidth=4)

//0plot(doma2 ? out2 : na, title="2nd Multi-TimeFrame Moving Average", color=col2, style=plot.style_circles, linewidth=4)

//plot(sd and ta.cross(out1, out2) ? out2 : na, style=plot.style_cross, linewidth=15, color=color.aqua)

cond = ma_up and sqzOff

if cond and not cond[1]

    //alert('MA breakout detected\n' + syminfo.ticker + ' timeframe ' + timeframe.period)

    log.info("MA breakout detected\n " + syminfo.ticker + " " + timeframe.period + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "ma_up: " + str.tostring(ma_up) + "\n" + "sqzOff: " + str.tostring(sqzOff) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))



//cond_down = ma_down //and sqzOn

cond_down =ma_down and out1 > close and out1 > open and open> close

if cond_down and not cond_down[1]

    //alert('MA breakout detected\n' + syminfo.ticker + ' timeframe ' + timeframe.period)

    log.info("MA breakout detected\n " + syminfo.ticker + " " + timeframe.period + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "ma_up: " + str.tostring(ma_up) + "\n" + "sqzOff: " + str.tostring(sqzOff) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))



[plusDI, minusDI, adx] = ta.dmi(14, 14)



isStrategyPositive = strategy.netprofit > 0



// Get strategy performance metrics

closedTrades = strategy.closedtrades

winningTrades = strategy.wintrades



// Calculate win rate (handle zero-division case)

winRate = closedTrades > 0 ? (winningTrades / closedTrades) * 100 : 0



// Define condition: win rate must be at least 50%

isStrategyWinning = winRate >= 50

// ══════════════════════════════════════════════════════════════════════════
// ENHANCED EXIT SYSTEM v2  — ATR Stops + Trailing + TP Targets + Decay
// ══════════════════════════════════════════════════════════════════════════

// ── ATR Exit Settings ──────────────────────────────────────────────────────
var string GRP_ATR = "ATR Exit Settings"
entry_override  = input.float (0.0,  "Entry Price Override (0 = auto from buy signal)", group=GRP_ATR, tooltip="Set your actual entry price here. Leave 0 to auto-detect from system buy signal.")
hard_mult       = input.float (2.0,  "Hard Stop Multiplier  (×ATR)",  group=GRP_ATR, step=0.1, minval=0.5, maxval=5.0)
trail_mult_in   = input.float (1.5,  "Trailing Stop Multiplier (×ATR)", group=GRP_ATR, step=0.1, minval=0.5, maxval=5.0)
tp1_r_in        = input.float (1.5,  "Take Profit 1 (×R)",  group=GRP_ATR, step=0.1, minval=0.5)
tp2_r_in        = input.float (3.0,  "Take Profit 2 (×R)",  group=GRP_ATR, step=0.1, minval=1.0)
standalone_mode = input.bool  (true, "Standalone Mode — sell without prior buy signal", group=GRP_ATR, tooltip="Enable if you already hold a position bought outside this system.")
decay_bars      = input.int   (3,    "Signal Decay: bars to confirm",  group=GRP_ATR, minval=1, maxval=10)

// ── Derived ATR ────────────────────────────────────────────────────────────
atr14 = ta.atr(14)

// ── Strictly-confirmed buy trigger (original system) ─────────────────────
triggerBuy = macdAboveSignal and rsi >= 63 and ma_up and (BUY or LongTrade or srBuySignal) and percent_valid and adx > 25 and plusDI > minusDI

var bool canTriggerBuy  = true
var bool canTriggerSell = false   // for original state-machine path

// ── Entry tracking variables ───────────────────────────────────────────────
var float tracked_entry    = na    // entry price being monitored
var float tracked_atr      = na    // ATR at entry
var float tracked_hwm      = na    // high-water mark since entry
var int   bars_in_position = 0     // trading-days counter

// Set entry from system buy signal
if triggerBuy and not triggerBuy[1] and canTriggerBuy
    tracked_entry    := close
    tracked_atr      := atr14
    tracked_hwm      := close
    bars_in_position := 0
    canTriggerBuy    := false
    canTriggerSell   := true

// Override with user-supplied entry price (standalone mode)
override_active = entry_override > 0.0
eff_entry   = override_active ? entry_override : tracked_entry
eff_atr     = override_active ? atr14          : tracked_atr   // use current ATR when manual
// For HWM: if manual entry, track from start of chart or use current running max
var float manual_hwm = na
if override_active
    manual_hwm := na(manual_hwm) ? high : math.max(manual_hwm, high)
eff_hwm = override_active ? manual_hwm : tracked_hwm

// Update HWM for auto-tracked positions
if not override_active and not na(tracked_entry)
    tracked_hwm      := math.max(nz(tracked_hwm, close), high)
    bars_in_position += 1

// ── Stop Level Calculations ────────────────────────────────────────────────
has_pos         = not na(eff_entry)

hard_stop_raw   = has_pos ? eff_entry - hard_mult   * eff_atr  : na
floor_stop      = has_pos ? eff_entry * 0.92                   : na   // max 8% absolute loss
eff_hard        = has_pos ? math.max(hard_stop_raw, floor_stop) : na

be_level        = has_pos ? eff_entry + eff_atr                : na   // break-even trigger
be_active       = has_pos and not na(eff_hwm) and eff_hwm >= nz(be_level, 0.0)
eff_floor       = has_pos ? (be_active ? eff_entry : eff_hard) : na

trail_stop      = has_pos and not na(eff_hwm) ? eff_hwm - trail_mult_in * atr14 : na
eff_stop        = has_pos and not na(eff_floor) and not na(trail_stop) ? math.max(eff_floor, trail_stop) : eff_floor

// ── R-Multiple Targets ─────────────────────────────────────────────────────
R_size   = has_pos ? hard_mult * eff_atr         : na
tp1_lvl  = has_pos and not na(R_size) ? eff_entry + tp1_r_in * R_size : na
tp2_lvl  = has_pos and not na(R_size) ? eff_entry + tp2_r_in * R_size : na

// ── Signal Decay Detection ─────────────────────────────────────────────────
// Count bearish momentum flags
decay_rsi_flag = rsi      < 45
decay_adx_flag = adx      < 20
decay_vol_flag = volume   < ta.sma(volume, 20) * 0.5
decay_count_v  = (decay_rsi_flag ? 1 : 0) + (decay_adx_flag ? 1 : 0) + (decay_vol_flag ? 1 : 0)

// Require decay_bars consecutive bars with 2+ flags
decay_persistent = ta.barssince(decay_count_v < 2) >= decay_bars

// ── Time Stop (20 trading days with < 3% gain) ─────────────────────────────
gain_pct    = has_pos ? (close - eff_entry) / eff_entry * 100.0 : na
time_stop   = has_pos and bars_in_position >= 20 and not na(gain_pct) and gain_pct < 3.0

// ── Original MA breakdown condition (kept as-is) ───────────────────────────
cond_down = ma_down and out1 > close and out1 > open and open > close

// ── Exit Condition Gates ───────────────────────────────────────────────────
sell_stop     = has_pos and not na(eff_stop) and close <= eff_stop
sell_breakdown= cond_down and not cond_down[1] and (standalone_mode or canTriggerSell)
sell_decay    = has_pos and decay_persistent and not decay_persistent[1]
sell_time     = has_pos and time_stop and not time_stop[1]
tp1_crossed   = has_pos and not na(tp1_lvl) and high >= tp1_lvl and high[1] < tp1_lvl
tp2_crossed   = has_pos and not na(tp2_lvl) and high >= tp2_lvl and high[1] < tp2_lvl

isInLastYear  = time >= (timenow - 365 * 24 * 60 * 60 * 1000)

// ── Plots ──────────────────────────────────────────────────────────────────
plot(has_pos ? eff_stop   : na, "Effective Stop",  color=color.red,                    style=plot.style_linebr, linewidth=1)
plot(has_pos ? eff_hard   : na, "Hard Stop",       color=color.new(color.red, 60),     style=plot.style_linebr, linewidth=1)
plot(has_pos ? tp1_lvl    : na, "TP1",             color=color.new(color.lime, 40),    style=plot.style_linebr)
plot(has_pos ? tp2_lvl    : na, "TP2",             color=color.new(color.lime, 20),    style=plot.style_linebr)
plot(has_pos ? eff_entry  : na, "Entry",           color=color.new(color.yellow, 50),  style=plot.style_linebr, linewidth=1)

// Sell signal shapes
plotshape(sell_stop,      title="Stop Hit",      location=location.belowbar, color=color.red,    style=shape.triangleup, size=size.normal,  text="STOP")
plotshape(sell_breakdown, title="MA Breakdown",  location=location.belowbar, color=color.orange, style=shape.triangledown, size=size.small, text="SELL")
plotshape(sell_decay,     title="Signal Decay",  location=location.belowbar, color=color.fuchsia,style=shape.circle,    size=size.small,  text="DECAY")
plotshape(sell_time,      title="Time Stop",     location=location.belowbar, color=color.purple, style=shape.square,    size=size.small,  text="TIME")
plotshape(tp1_crossed,    title="TP1 Hit",       location=location.abovebar, color=color.lime,   style=shape.labeldown, size=size.small,  text="TP1")
plotshape(tp2_crossed,    title="TP2 Hit",       location=location.abovebar, color=color.green,  style=shape.labeldown, size=size.small,  text="TP2")

// ── Alert Conditions (set once on TradingView, fires automatically) ─────────
alertcondition(sell_stop,      title="🔴 Stop Loss Hit",  message="STOP HIT: {{ticker}} @ {{close}} | TF: {{interval}}")
alertcondition(sell_breakdown, title="🟠 Bearish Breakdown", message="BREAKDOWN: {{ticker}} @ {{close}} | TF: {{interval}}")
alertcondition(sell_decay,     title="🟣 Signal Decay",   message="DECAY: {{ticker}} RSI<45 or ADX<20 | {{close}} | TF: {{interval}}")
alertcondition(sell_time,      title="⏱ Time Stop",       message="TIME STOP: {{ticker}} 20+ days <3% gain | {{close}} | TF: {{interval}}")
alertcondition(tp1_crossed,    title="🟢 TP1 Reached",    message="TP1 HIT: {{ticker}} @ {{close}} | TF: {{interval}}")
alertcondition(tp2_crossed,    title="🟢 TP2 Reached",    message="TP2 HIT: {{ticker}} @ {{close}} | TF: {{interval}}")

// ── Rich Alert Messages (triggered on each bar) ──────────────────────────
if sell_stop and isInLastYear
    alert("🔴 STOP HIT: " + syminfo.ticker +
          " | Price: "  + str.tostring(close,       format.mintick) +
          " | Stop: "   + str.tostring(eff_stop,    format.mintick) +
          " | Entry: "  + str.tostring(eff_entry,   format.mintick) +
          " | Gain%: "  + str.tostring(nz(gain_pct, 0.0), "#.##") + "%" +
          " | TF: "     + timeframe.period)
    strategy.close("Long", comment="Stop Hit")
    // Reset auto-tracking
    tracked_entry := na
    canTriggerBuy  := true
    canTriggerSell := false

if sell_breakdown and isInLastYear
    alert("🟠 BEARISH BREAKDOWN: " + syminfo.ticker +
          " | RSI: "    + str.tostring(rsi,  "#.#") +
          " | ADX: "    + str.tostring(adx,  "#.#") +
          " | sqzOff: " + str.tostring(sqzOff) +
          " | Price: "  + str.tostring(close, format.mintick) +
          " | TF: "     + timeframe.period)
    strategy.close("Long", comment="MA Breakdown")
    if not override_active
        tracked_entry  := na
        canTriggerBuy  := true
        canTriggerSell := false

if sell_decay and isInLastYear
    alert("🟣 SIGNAL DECAY: " + syminfo.ticker +
          " | Flags: "  + str.tostring(decay_count_v) + "/3" +
          " | RSI: "    + str.tostring(rsi, "#.#") +
          " | ADX: "    + str.tostring(adx, "#.#") +
          " | Price: "  + str.tostring(close, format.mintick) +
          " | TF: "     + timeframe.period)

if sell_time and isInLastYear
    alert("⏱ TIME STOP: " + syminfo.ticker +
          " | Days: "   + str.tostring(bars_in_position) +
          " | Gain%: "  + str.tostring(nz(gain_pct, 0.0), "#.##") + "%" +
          " | Price: "  + str.tostring(close, format.mintick) +
          " | TF: "     + timeframe.period)

if tp1_crossed and isInLastYear
    alert("🟢 TP1 REACHED: " + syminfo.ticker +
          " | TP1: "    + str.tostring(tp1_lvl, format.mintick) +
          " | Price: "  + str.tostring(close,   format.mintick) +
          " | R: ×"     + str.tostring(tp1_r_in, "#.#") +
          " | TF: "     + timeframe.period)

if tp2_crossed and isInLastYear
    alert("🟢 TP2 REACHED: " + syminfo.ticker +
          " | TP2: "    + str.tostring(tp2_lvl, format.mintick) +
          " | Price: "  + str.tostring(close,   format.mintick) +
          " | R: ×"     + str.tostring(tp2_r_in, "#.#") +
          " | TF: "     + timeframe.period)

// ── Strategy entry (for backtesting only) ─────────────────────────────────
if triggerBuy and not triggerBuy[1] and canTriggerBuy
    strategy.entry("Long", strategy.long)

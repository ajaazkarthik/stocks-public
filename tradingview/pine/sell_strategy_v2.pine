                    log.info("Bullish 4 simple breakout skipped " + syminfo.ticker +' sqzOff: '+ str.tostring(sqzOff)+ " " + timeframe.period + "\n" + "Volume: " + str.tostring(nz(b.v)) + "\n" + "vSMA: " + str.tostring(vSMA) + "\n" + "RSI: " + str.tostring(rsi) + "\n" + "MACD: " + str.tostring(macdVal) + "\n" + "Signal: " + str.tostring(signalVal) + "\n" + "macdAboveSignal: " + str.tostring(macdAboveSignal))





        // else if lSt.b and b.o[1] < lRt.bx.get_top() and b.h[1] > lRt.bx.get_bottom() and b.c[1] < lRt.bx.get_bottom() and not lRt.r and b.i[1] != lRt.bx.get_left()

        //     label.new(b.i[1], b.h[1] * (1 + lRt.m * .017), 'R', color = srRDC, style = label.style_label_down , textcolor = srRTC, size = f_getSize(srRS), tooltip = 'Re-test of Resistance Zone' + vST[1] )

        //     lRt.r := true //

        //     lRt.bx.set_right(b.i)

        //     lRt.ln.set_x2(b.i)



